<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Beat Bühler. SetCraft uses aubio, libKeyFinder, FFTW, TagLib, Sparkle and GRDB — see About for licenses.</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Audio File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.audio</string>
				<string>public.mp3</string>
				<string>public.mpeg-4-audio</string>
				<string>com.apple.m4a-audio</string>
				<string>com.apple.coreaudio-format</string>
				<string>org.xiph.flac</string>
				<string>com.microsoft.waveform-audio</string>
				<string>public.aifc-audio</string>
				<string>public.aiff-audio</string>
			</array>
		</dict>
	</array>
	<!-- ============================================================
	     Sparkle-Update-Konfiguration
	     ============================================================
	     SUFeedURL    : statisch gehosteter Appcast (XML). Vor dem ersten
	                    notarisierten Release auf die echte URL setzen.
	     SUPublicEDKey: EdDSA-Public-Key, mit dessen privatem Pendant das
	                    Release-Skript jedes DMG signiert. Wird einmalig
	                    mit Sparkles `generate_keys` erzeugt (Private-Key
	                    landet im Keychain, Public-Key kommt hier rein).
	     Siehe `docs/DISTRIBUTION.md` für die Einrichtung. -->
	<key>SUFeedURL</key>
	<string>https://synapsetm.github.io/SetCraft/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>dSzx1684Glnr7zn9W3Xmbw8W05gdtc0LH6cRFL9JREI=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<!-- Signierter Appcast plus Prüfung VOR dem Entpacken. Die beiden Keys
	     gehören zusammen — Sparkle bricht beim Start mit einem Fehler ab,
	     wenn `SURequireSignedFeed` ohne `SUVerifyUpdateBeforeExtraction`
	     gesetzt ist (SPUUpdater.m, „needs to also be enabled").

	     Ohne sie war die Lage schon nicht offen: jedes DMG trägt seine
	     EdDSA-Signatur im Appcast, ein manipulierter Feed allein kann also
	     keinen fremden Code ausliefern. Was die Keys zusätzlich bringen:
	     der Entpacker (zip/aar) sieht keine unverifizierten Bytes mehr, und
	     die Feed-Metadaten selbst — Version, Release Notes, Mindest-OS —
	     sind authentifiziert statt nur per HTTPS geholt.

	     `generate_appcast` liest `SURequireSignedFeed` aus dem Bundle im
	     Archiv (ArchiveItem.swift) und signiert den Appcast daraufhin
	     selbst, mit demselben Keychain-Key wie die DMGs. release.sh kopiert
	     das Ergebnis unverändert nach docs/ — wer appcast.xml danach von
	     Hand anfasst, macht die Feed-Signatur ungültig und muss
	     `generate_appcast` erneut laufen lassen. Alte Clients ohne diese
	     Keys ignorieren die zusätzliche Signatur. -->
	<key>SURequireSignedFeed</key>
	<true/>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<!-- Sandbox-Modus: Sparkles Installer- und Downloader-XPC-Services
	     aktivieren. Damit lädt und installiert Sparkle aus den XPCs heraus
	     (siehe Mach-Lookup-Entitlements in SetCraft.entitlements und
	     https://sparkle-project.org/documentation/sandboxing/). Ohne diese
	     Schalter scheitert „Check for Updates…" in der Sandbox mit
	     "Failed to submit installer job" / Mach-Lookup-Deny auf -spks. -->
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<key>SUEnableDownloaderService</key>
	<true/>
</dict>
</plist>
