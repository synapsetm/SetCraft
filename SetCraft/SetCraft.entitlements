<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Ausgehende HTTPS-Verbindungen: gebraucht für den Discogs-Abgleich
	     der Tag-Ergänzung (api.discogs.com). Ohne dieses Entitlement
	     scheitert in der Sandbox jede URLSession-Anfrage, und zwar mit einer
	     nichtssagenden Netzwerkfehlermeldung — die Vorschlagskette meldete
	     dann für jeden Track „Discogs nicht erreichbar". -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Sparkle 2 im Sandbox-Modus: der Sparkle-Downloader-XPC lädt die
	     Update-Dateien und der Installer-XPC führt die Installation aus.
	     Das bleibt so, auch jetzt mit `network.client` — die XPC-Services
	     sind bereits eingerichtet und signiert. Die Mach-Lookup-Exceptions geben der App die
	     Erlaubnis, sich mit den beiden XPC-Services zu verbinden, die
	     Sparkle unter `<bundle-id>-spks` (Installer) und `<bundle-id>-spki`
	     (Downloader) registriert. Siehe
	     https://sparkle-project.org/documentation/sandboxing/.

	     Hier stand bis 2026-10-02 zusätzlich `com.apple.audioanalyticsd`.
	     AVAudioEngine ruft den Dienst beim Setup intern an, und ohne die
	     Exception schreibt die Sandbox eine PRECONDITION-FAILURE-Warnung in
	     die Konsole. Funktional braucht es sie nicht — Audio lief auch vorher
	     ohne sie. Eine `temporary-exception` ist aber eine echte Erweiterung
	     der Sandbox und müsste bei einer App-Store-Abgabe begründet werden,
	     und das für eine Log-Zeile. Darum entfernt: die Warnung ist zurück,
	     die Berechtigung weg. Nicht wieder aufnehmen, ohne einen Befund zu
	     haben, der über die Konsolenmeldung hinausgeht. -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
	</array>
</dict>
</plist>
